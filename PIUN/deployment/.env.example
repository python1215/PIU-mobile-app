# PIU M&E System - Environment Variables Configuration
# Copy this file to .env and update with your actual values

# Django Settings
SECRET_KEY=your-very-secret-key-here-minimum-50-characters-long
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-server-ip-here

# Database Configuration
DB_HOST=localhost
DB_PORT=1433
DB_NAME=piuprod3
DB_USER=piu_user
DB_PASSWORD=P1U_S3cur3_P@ssw0rd!

# SQL Server specific settings
USE_SQL_SERVER=True
DATABASE_TIMEOUT=30
DATABASE_POOL_SIZE=20

# Email Configuration (Optional)
EMAIL_HOST=smtp.your-domain.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@domain.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@piu-system.local

# File Upload Settings
FILE_UPLOAD_MAX_MEMORY_SIZE=16777216
DATA_UPLOAD_MAX_MEMORY_SIZE=16777216

# Security Settings
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/piu_system.log

# Application Settings
SITE_NAME=PIU M&E System
SITE_URL=http://localhost:8000
ADMIN_EMAIL=admin@piu-system.local

# Backup Settings
BACKUP_PATH=C:\PIU_Backups
BACKUP_RETENTION_DAYS=30

# Performance Settings
CACHE_TIMEOUT=300
SESSION_TIMEOUT=86400