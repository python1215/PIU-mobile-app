modules = ["nodejs-20"]

[nix]
channel = "stable-24_05"
packages = []

[deployment]
deploymentTarget = "vm"
build = ["sh", "-c", "npm install"]
run = ["sh", "-c", "npx expo start --host 0.0.0.0"]


[workflows]
runButton = "Mobile App"

[[workflows.workflow]]
name = "Mobile App"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Expo"

[[workflows.workflow]]
name = "Start Expo"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx expo start --host 0.0.0.0"

[agent]
integrations = []

[[ports]]
localPort = 23636
externalPort = 3001
